# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# generated framework caches
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# hosting and local preview caches
.vercel
/.wrangler/

# static build output
/dist/
/outputs/
/work/

# Local planning, historical assets and release evidence
/.public-release/
/.zinxlaunch/
/archive/
/DESIGN.md
/PRODUCT.md
/EXHIBITION_PLAN.md
/REFINEMENT_PLAN.md
/YY_ACTIONS_QA.md
/YY_DANCE_QA.md
/QA_CARD_TABLE_2026-09-22.md

