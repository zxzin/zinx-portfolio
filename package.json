{
  "name": "zinx-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:yy": "node scripts/yy-appearance.mjs --sync && node scripts/yy-actions.mjs --sync",
    "verify:yy": "node scripts/yy-appearance.mjs && node scripts/yy-actions.mjs",
    "package:assets": "node scripts/package-public-assets.mjs",
    "predev": "npm run verify:yy && npm run package:assets",
    "dev": "vite",
    "prebuild": "npm run verify:yy && npm run package:assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/static-build.test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.2"
  },
  "type": "module"
}
